<Window x:Class="LastRoadLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAST ROAD Launcher"
	Icon="Assets/launcher-icon.ico"
        Width="1280"
        Height="720"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#090B0C">

    <Window.Resources>

        <!-- SECONDARY BUTTON -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8E3D8"/>
            <Setter Property="Background" Value="#B51A1C1D"/>
            <Setter Property="BorderBrush" Value="#66706A5D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#D52B2C2C"/>

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#B7A77D4C"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#E0101112"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- PLAY BUTTON -->
        <Style x:Key="PlayButtonStyle" TargetType="Button">

            <Setter Property="Foreground" Value="#17130C"/>
            <Setter Property="Background" Value="#D6B56B"/>
            <Setter Property="BorderBrush" Value="#F0D89B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#E7C77B"/>

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#FFF0BE"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#B99751"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- WINDOW CONTROL BUTTON -->
        <Style x:Key="WindowControlButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="#E8E3D8"/>

            <Setter Property="Background"
                    Value="#650D0F10"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ControlBorder"
                                Background="{TemplateBinding Background}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ControlBorder"
                                        Property="Background"
                                        Value="#B32A2C2B"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ControlBorder"
                                        Property="Background"
                                        Value="#D0101112"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- CLOSE BUTTON -->
        <Style x:Key="CloseWindowButton"
               TargetType="Button"
               BasedOn="{StaticResource WindowControlButton}">

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#C06A2525"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- VIDEO CARD -->
        <Style x:Key="VideoCardButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#B50C0F10"/>

            <Setter Property="BorderBrush"
                    Value="#88786750"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="VideoBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="VideoBorder"
                                        Property="BorderBrush"
                                        Value="#E2C277"/>

                                <Setter TargetName="VideoBorder"
                                        Property="Effect">

                                    <Setter.Value>
                                        <DropShadowEffect Color="#D6B56B"
                                                          BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="0.42"/>
                                    </Setter.Value>

                                </Setter>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter Property="Opacity"
                                        Value="0.82"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <!-- BACKGROUND -->
        <Image Source="Assets/launcher-background.png"
               Stretch="UniformToFill"/>


        <!-- DARK GRADIENT -->
        <Rectangle IsHitTestVisible="False">

            <Rectangle.Fill>

                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,0">

                    <GradientStop Color="#8A000000"
                                  Offset="0"/>

                    <GradientStop Color="#22000000"
                                  Offset="0.34"/>

                    <GradientStop Color="#00000000"
                                  Offset="0.65"/>

                </LinearGradientBrush>

            </Rectangle.Fill>

        </Rectangle>


        <!-- DRAG AREA -->
        <Border Height="70"
                VerticalAlignment="Top"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>


        <!-- BRAND -->
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="58,43,0,0">

	    <Image Source="Assets/launcher-icon.png"
    		       Width="92"
                       Height="92"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,10"/>

            <TextBlock Text="LINEAGE II · INTERLUDE"
                       Foreground="#E6DED0"
                       FontFamily="Georgia"
                       FontSize="15"
                       FontWeight="Bold"/>

            <TextBlock Text="LAST ROAD"
                       Foreground="#F3EFE6"
                       FontFamily="Georgia"
                       FontSize="52"
                       Margin="0,0,0,1">

                <TextBlock.Effect>

                    <DropShadowEffect Color="Black"
                                      BlurRadius="7"
                                      ShadowDepth="2"
                                      Opacity="0.7"/>

                </TextBlock.Effect>

            </TextBlock>

            <Border Width="286"
                    Height="1"
                    HorizontalAlignment="Left"
                    Background="#BFA76A"
                    Margin="1,0,0,8"/>

            <TextBlock Text="OLD WORLD. NEW PATH."
                       Foreground="#D6C7A6"
                       FontFamily="Georgia"
                       FontSize="14"/>

        </StackPanel>


        <!-- TOP RIGHT -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,18,18,0">

            <!-- LANGUAGE -->
            <Border Padding="12,7"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Background="#8F101213"
                    BorderBrush="#50766B55"
                    BorderThickness="1"
                    CornerRadius="2">

                <StackPanel Orientation="Horizontal">

                    <RadioButton x:Name="UaLanguage"
                                 Content="UA"
                                 Foreground="#E7DFD0"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Margin="0,0,14,0"
                                 VerticalAlignment="Center"
                                 Checked="Language_Checked"/>

                    <RadioButton x:Name="EnLanguage"
                                 Content="EN"
                                 Foreground="#E7DFD0"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Checked="Language_Checked"/>

                </StackPanel>

            </Border>


            <!-- MINIMIZE -->
            <Button Content="—"
                    Width="42"
                    Height="32"
                    Margin="0,0,2,0"
                    Style="{StaticResource WindowControlButton}"
                    Click="MinimizeButton_Click"/>


            <!-- CLOSE -->
            <Button Content="×"
                    Width="42"
                    Height="32"
                    FontSize="20"
                    Style="{StaticResource CloseWindowButton}"
                    Click="CloseButton_Click"/>

        </StackPanel>


        <!-- VIDEO CARDS -->
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="300"
                    Margin="0,100,30,0">



            <!-- COOPERATION VIDEO -->
            <Button Style="{StaticResource VideoCardButton}"
                    Height="178"
                    Margin="0,0,0,12"
                    Click="CooperationVideo_Click">

                <Grid>

                    <Image Source="Assets/video-cooperation.png"
                           Stretch="UniformToFill"/>



                    <Border Width="42"
                            Height="42"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#B9000000"
                            BorderBrush="#D6B56B"
                            BorderThickness="1"
                            CornerRadius="21">

                        <TextBlock Text="▶"
                                   Foreground="#E4C77D"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="3,0,0,1"/>

                    </Border>

                </Grid>

            </Button>


            <!-- INTERLUDE VS CLASSIC VIDEO -->
            <Button Style="{StaticResource VideoCardButton}"
                    Height="178"
                    Click="InterludeVsClassicVideo_Click">

                <Grid>

                    <Image Source="Assets/video-interlude-vs-classic.png"
                           Stretch="UniformToFill"/>



                    <Border Width="42"
                            Height="42"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#B9000000"
                            BorderBrush="#D6B56B"
                            BorderThickness="1"
                            CornerRadius="21">

                        <TextBlock Text="▶"
                                   Foreground="#E4C77D"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="3,0,0,1"/>

                    </Border>

                </Grid>

            </Button>

        </StackPanel>


        <!-- BOTTOM PANEL -->
        <Border VerticalAlignment="Bottom"
                Height="118"
                Background="#DB0C0F10"
                BorderBrush="#5572634D"
                BorderThickness="0,1,0,0">

            <Grid Margin="38,17,38,15">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- STATUS -->
                <Grid Grid.Column="0"
                      Margin="0,0,30,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal">

                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="#C9B16F"
                                 Margin="0,0,9,0"
                                 VerticalAlignment="Center"/>

                        <TextBlock x:Name="StatusText"
                                   Text="Client status: Connecting..."
                                   Foreground="#ECE7DC"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>

                    </StackPanel>


                    <!-- PROGRESS -->
                    <Grid Grid.Row="1"
                          Margin="0,11,0,0"
                          Height="7"
                          MaxWidth="650"
                          HorizontalAlignment="Stretch">

                        <Border Background="#451F2222"
                                CornerRadius="1"/>

                        <ProgressBar x:Name="UpdateProgress"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Height="7"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#C5A65E"/>

                    </Grid>


                    <TextBlock Grid.Row="2"
                               Text="last-road.com"
                               Foreground="#8F918E87"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Margin="0,9,0,0"/>

                </Grid>


                <!-- ACTIONS -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="UpdateButton"
                            Content="UPDATE"
                            Style="{StaticResource SecondaryButton}"
                            Width="112"
                            Height="48"
                            Margin="0,0,8,0"
                            Click="UpdateButton_Click"/>

                    <Button x:Name="RepairButton"
                            Content="REPAIR"
                            Style="{StaticResource SecondaryButton}"
                            Width="112"
                            Height="48"
                            Margin="0,0,13,0"
                            Click="RepairButton_Click"/>

                    <Button x:Name="PlayButton"
                            Content="PLAY"
                            Style="{StaticResource PlayButtonStyle}"
                            Width="180"
                            Height="58"
                            Click="PlayButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- OUTER BORDER -->
        <Border BorderBrush="#594A3C2D"
                BorderThickness="1"
                IsHitTestVisible="False"/>

    </Grid>

</Window>